---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
// 🌟 ШАГ 1: Импортируем новый виджет Trustindex
import ReviewsWidget from '../components/ReviewsWidget.astro';
import CTA from '../components/CTA.astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';

const { reviews } = siteData;
---

<BaseLayout
  title="Отзывы"
  description={`Читайте отзывы и рекомендации клиентов компании ${brand.name}. Узнайте, почему автовладельцы доверяют нам свой ремонт.`}
  schema={{
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    name: siteData.name,
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: '5',
      reviewCount: String(reviews.length),
      bestRating: '5',
    },
  }}
>
  <Header slot="header" />

  <Banner title="Отзывы клиентов" />

  <section class="py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Что о нас говорят</h2>
        <p class="mt-3 text-text-muted leading-relaxed">
          Не верьте нам на слово — посмотрите отзывы автовладельцев, которым мы уже помогли.
        </p>
      </div>

      {/* 🌟 ШАГ 2: Выводим новый Trustindex-виджет вместо старой статичной сетки */}
      <ReviewsWidget />
      
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>
