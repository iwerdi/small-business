---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import CTA from '../components/CTA.astro';
import { Image } from 'astro:assets';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import myTeamImage from '../assets/images/about/my-team.jpg';

const { about } = siteData;
---

<BaseLayout title="О нас" description={`Узнайте больше о компании ${brand.name} — наша история, команда и приверженность высокому качеству услуг.`}>
  <Header slot="header" />

  <Banner title="О нас" />

  <!-- История -->
  <section class="py-section">
    <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
      <div class="overflow-hidden rounded-lg shadow-lg">
        <Image
          src={myTeamImage}
          alt="Наша команда обсуждает рабочий процесс"
          width={800}
          height={1200}
          loading="lazy"
          class="size-full object-cover"
        />
      </div>
      <div class="space-y-5">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Наша история</span>
        <h2 class="font-heading text-h2 font-bold uppercase text-text">Основано на доверии, сфокусировано на качестве</h2>
        {about.story.map((paragraph) => (
          <p class="text-text-muted leading-relaxed text-justify indent-8">{paragraph}</p>
        ))}
      </div>
    </div>
  </section>

  <!-- Команда -->
  <section class="bg-surface py-section">
    <div class="mx-auto max-w-site px-4 sm:px-6">
      <div class="mx-auto mb-10 max-w-2xl text-center">
        <span class="text-topper font-bold uppercase tracking-widest text-accent">Наша команда</span>
        <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">Знакомьтесь с мастерами</h2>
      </div>

      <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-4">
        {about.team.map(({ name, role, image }) => (
          <div class="overflow-hidden rounded-lg bg-background shadow-sm">
            <img
              src={image}
              alt={`Фотография мастера: ${name}`}
              width="600"
              height="800"
              loading="lazy"
              decoding="async"
              class="aspect-[3/4] w-full bg-surface object-contain"
            />
            <div class="p-5">
              <h3 class="font-heading text-lg font-semibold text-text">{name}</h3>
              <p class="text-sm text-text-muted">{role}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />

  <Footer slot="footer" />
</BaseLayout>