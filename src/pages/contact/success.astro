---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { brand } from "../../config/brand";
---

<BaseLayout title="Сообщение отправлено" description="Ваше сообщение успешно получено.">
  <Header slot="header" />

  <section class="flex min-h-[60vh] items-center justify-center px-4">
    <div class="mx-auto max-w-md text-center">
      <div
        class="mx-auto mb-6 flex size-16 items-center justify-center rounded-full bg-accent/10"
      >
        <svg
          class="size-8 text-accent"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M5 13l4 4L19 7"></path>
        </svg>
      </div>

      <h1 class="font-heading text-h1 font-bold uppercase text-text">
        Сообщение получено
      </h1>
      <p class="mt-4 text-text-muted leading-relaxed">
        Спасибо за ваше обращение! Мы свяжемся с вами в течение одного рабочего дня.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex min-h-11 items-center justify-center rounded-md bg-primary px-8 py-3 text-base font-bold text-primary-fg shadow-sm transition-opacity hover:opacity-90"
      >
        Вернуться на главную
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>