---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Banner from "../../components/Banner.astro";
import { brand } from "../../config/brand";
import { siteData } from "../../data/siteData";
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<BaseLayout
  title="Контакты"
  description={`Свяжитесь с компанией ${brand.name}. Запросите консультацию или задайте нам вопрос.`}
>
  <Header slot="header" />

  <Banner title="Свяжитесь с нами" />

  <section class="py-section">
    <div
      class="mx-auto grid max-w-site grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-5 lg:gap-14"
    >
      <!-- Form -->
      <div class="lg:col-span-3">
        <h2 class="font-heading text-h2 font-bold uppercase text-text">
          Отправьте нам сообщение
        </h2>
        <p class="mt-2 mb-8 text-text-muted">
          Заполните форму ниже, и мы ответим вам в течение одного рабочего дня.
        </p>

        <form
          id="contact-form"
          name="contact"
          method="POST"
          class="flex flex-col gap-5"
          novalidate
        >
          <p class="hidden" aria-hidden="true">
            <label
              >Оставьте это поле пустым: <input
                name="bot-field"
                tabindex="-1"
                autocomplete="off"
              /></label
            >
          </p>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Имя{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Электронная почта{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text">Телефон</span>
            <input
              type="tel"
              name="phone"
              autocomplete="tel"
              inputmode="tel"
              class="min-h-11 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
          </label>

          <label class="flex flex-col gap-1.5">
            <span class="text-sm font-medium text-text"
              >Сообщение{" "}<span class="text-accent" aria-hidden="true">*</span
              ></span
            >
            <textarea
              name="message"
              rows="5"
              required
              class="min-h-30 rounded-md border border-border bg-background px-4 py-2.5 text-text transition-colors focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20 resize-none"
            ></textarea>
          </label>

          {turnstileSiteKey && (
            <div class="mt-1" aria-label="Проверка защиты от ботов">
              <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
            </div>
          )}
          <button
            type="submit"
            class="mt-2 inline-flex min-h-11 cursor-pointer items-center justify-center self-start rounded-md bg-accent px-8 py-3 text-base font-bold text-accent-fg shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
          >
            Отправить сообщение
          </button>
          <div
            id="contact-form-status"
            class="hidden rounded-md border p-4 text-sm"
            role="status"
            aria-live="polite"
          ></div>
        </form>
        <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
        <script>
          import { containsProfanity } from "../../data/profanityFilter.js";

          const form = document.querySelector<HTMLFormElement>("#contact-form");
          const status = document.querySelector<HTMLDivElement>("#contact-form-status");


          form?.addEventListener("submit", async (event) => {
            event.preventDefault();
            if (!form || !status) return;

            status.className = "rounded-md border p-4 text-sm";
            status.classList.remove("hidden");
            const values = new FormData(form);
            const name = String(values.get("name") || "").trim();
            const email = String(values.get("email") || "").trim();
            const message = String(values.get("message") || "").trim();

            if (!name || !email || !message) {
              status.classList.add("border-red-500", "text-red-600");
              status.textContent = "Заполните имя, электронную почту и сообщение.";
              return;
            }
            if (containsProfanity(message) || containsProfanity(name)) {
              status.classList.add("border-red-500", "text-red-600");
              status.textContent = "Сообщение содержит недопустимую или ненормативную лексику. Пожалуйста, отредактируйте текст.";
              return;
            }

            const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
            if (button) {
              button.disabled = true;
              button.textContent = "Отправка...";
            }
            status.textContent = "Отправляем сообщение...";
            status.setAttribute("aria-busy", "true");

            try {
              const response = await fetch("/api/contact", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  name,
                  email,
                  phone: String(values.get("phone") || "").trim(),
                  message,
                  "bot-field": String(values.get("bot-field") || ""),
                  "cf-turnstile-response": String(values.get("cf-turnstile-response") || ""),
                }),
              });
              const result = await response.json();
              const success = response.ok && result.ok;
              status.classList.add(...(success ? ["border-green-600", "text-green-700"] : ["border-red-500", "text-red-600"]));
              status.textContent = result.message || "Не удалось обработать сообщение.";
              if (success) form.reset();
              if (result.code === "CAPTCHA") {
                (window as Window & { turnstile?: { reset: () => void } }).turnstile?.reset();
              }
            } catch {
              status.classList.add("border-red-500", "text-red-600");
              status.textContent = "Не удалось связаться с сервером. Попробуйте ещё раз или позвоните нам.";
            } finally {
              status.removeAttribute("aria-busy");
              if (button) {
                button.disabled = false;
                button.textContent = "Отправить сообщение";
              }
            }
          });
        </script>
      </div>

      <!-- Contact info sidebar -->
      <aside class="space-y-8 lg:col-span-2">
        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Позвоните нам</h3>
          <a
            href={`tel:${siteData.phoneForTel}`}
            class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary"
          >
            {siteData.phoneFormatted}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Напишите нам на почту</h3>
          <a
            href={`mailto:${siteData.email}`}
            class="mt-1 block font-medium text-primary-light transition-colors hover:text-primary"
          >
            {siteData.email}
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Наш адрес</h3>
          <a
            href={siteData.address.mapLink}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-1 block text-text-muted transition-colors hover:text-text"
          >
            {siteData.address.lineOne}<br />
            {
              siteData.address.lineTwo && (
                <>
                  {siteData.address.lineTwo}
                  <br />
                </>
              )
            }
            {siteData.address.city}, {siteData.address.state}{" "}{
              siteData.address.zip
            }
          </a>
        </div>

        <div>
          <h3 class="font-heading text-lg font-semibold text-text">Часы работы</h3>
          <div class="mt-1 space-y-1 text-text-muted">
            {
              siteData.hours.map(({ days, time }) => (
                <p>
                  {days}: {time}
                </p>
              ))
            }
            {
              siteData.emergencyService && (
                <p class="mt-2 font-medium text-accent">
                  {siteData.emergencyService}
                </p>
              )
            }
          </div>
        </div>
      </aside>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>