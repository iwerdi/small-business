---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Banner from '../components/Banner.astro';
import LegalPage from '../components/LegalPage.astro';
import { brand } from '../config/brand';
import { privacyPolicy } from '../data/privacy';
---

<BaseLayout title="Политика конфиденциальности" description={`Политика конфиденциальности компании ${brand.name}. Узнайте, как мы собираем, используем и защищаем вашу информацию.`}>
  <Header slot="header" />

  <Banner title="Политика конфиденциальности" />

  <LegalPage effectiveDate={privacyPolicy.effectiveDate} sections={privacyPolicy.sections} />

  <Footer slot="footer" />
</BaseLayout>