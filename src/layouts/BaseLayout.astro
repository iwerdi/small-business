---
/**
* Базовый макет — оборачивает каждую страницу. 
*
* Используемые возможности Astro 7:
*  • <Font />         — встроенный оптимизатор шрифтов (на основе массива fonts в astro.config.mjs)
*  • <ClientRouter /> — клиентская навигация с CSS-анимациями переходов
*/
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import ScrollToTop from '../components/ScrollToTop.astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>;
}

const {
  title = brand.name,
  description = brand.description,
  image = '/og-image.png',
  schema,
} = Astro.props;

const pageTitle = title === brand.name ? title : `${title} — ${brand.name}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? brand.url);
---

<html lang={brand.locale.split('_')[0]} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:title"       content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={image} />
    <meta property="og:locale"      content={brand.locale} />

    <!-- Twitter Card -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={image} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />

    <!-- Fonts -->
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body"    preload />

    <!-- JSON-LD Structured Data -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <slot name="head" />
    <ClientRouter />
  </head>

  <body class="bg-background text-text font-body antialiased">
    <a
      class="sr-only focus:not-sr-only focus:absolute focus:z-[99999] focus:bg-primary focus:text-primary-fg focus:px-4 focus:py-2 focus:rounded-md"
      href="#main"
    >
      Перейти к основному содержимому
    </a>

    <slot name="header" />

    <main id="main">
      <slot />
    </main>

    <slot name="footer" />

    <ScrollToTop />

    <script>
      /**
       * Сброс прокрутки при переходе по ссылкам.
       *
       * Из-за плавной прокрутки (scroll-behavior: smooth) и постоянного подвала
       * (transition:persist) страница могла оставаться в самом низу после перехода.
       * Здесь мы принудительно и МГНОВЕННО возвращаемся наверх, кроме случаев:
       *  • кнопки «Назад/Вперёд» — браузер сам восстанавливает прежнюю позицию;
       *  • ссылки с якорем (#...) — нужно прокрутить к нужному месту;
       *  • первой загрузки и обновления страницы (F5) — это не переход.
       */
      let pendingReset = false;

      document.addEventListener("astro:before-swap", (e) => {
        const type = (e as unknown as { navigationType?: string }).navigationType;
        pendingReset = type !== "traverse";
      });

      function resetScroll() {
        if (!pendingReset || window.location.hash) return;
        const root = document.documentElement;
        root.style.scrollBehavior = "auto";
        window.scrollTo(0, 0);
        requestAnimationFrame(() => root.style.removeProperty("scroll-behavior"));
      }

      document.addEventListener("astro:after-swap", resetScroll);
      // Страховка: повторяем после завершения перехода и сбрасываем флаг.
      document.addEventListener("astro:page-load", () => {
        resetScroll();
        pendingReset = false;
      });
    </script>
  </body>
</html>
