---
import { Image } from "astro:assets";
import { galleryImages as defaultImages } from "../config/images";
import type { GalleryImage } from "../config/images";

interface Props {
  topper?: string;
  heading?: string;
  description?: string;
  images?: GalleryImage[];
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  topper = "Наши работы",
  heading = "Примеры выполненного ремонта",
  description = "Оцените качество и внимание к деталям, с которыми мы подходим к обслуживанию каждого автомобиля.",
  images = defaultImages,
  ctaLabel = "Посмотреть все услуги",
  ctaHref = "/services",
} = Astro.props;
---

<section class="py-section">
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <span class="text-topper font-bold uppercase tracking-widest text-accent"
        >{topper}</span
      >
      <h2 class="mt-2 font-heading text-h2 font-bold uppercase text-text">
        {heading}
      </h2>
      <p class="mt-3 text-text-muted leading-relaxed">{description}</p>
    </div>

    <div class="grid grid-cols-1 gap-3 sm:gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        images.map(({ src, alt }, idx) => (
          <button
            type="button"
            class="group relative overflow-hidden rounded-lg aspect-4/3 bg-surface cursor-pointer text-left"
            data-gallery-item
            data-gallery-index={idx}
            aria-label={`View full image: ${alt}`}
          >
            {/* Shimmer skeleton — visible while the image loads */}
            <div
              class="absolute inset-0 animate-pulse bg-linear-to-r from-surface via-border to-surface"
              aria-hidden="true"
              data-skeleton
            />

            <Image
              src={src}
              alt={alt}
              width={600}
              height={450}
              loading="lazy"
              decoding="async"
              class="relative size-full object-cover opacity-0 transition-all duration-300 group-hover:scale-105"
              data-gallery-img
            />

            {/* Error fallback — revealed by JS when src fails to load */}
            <div
              class="absolute inset-0 hidden flex-col items-center justify-center gap-2 bg-surface text-sm text-text-muted"
              data-error-state
              aria-label="Image unavailable"
            >
              <svg
                class="size-8 opacity-40"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                />
              </svg>
              <span class="text-xs">Image unavailable</span>
            </div>

            {/* Hover caption overlay */}
            <div class="absolute inset-0 flex items-end bg-linear-to-t from-dark/60 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100">
              <p class="p-3 text-sm font-medium text-white sm:p-4">{alt}</p>
            </div>
          </button>
        ))
      }
    </div>

    {/* ── Lightbox dialog ─────────────────────────────────────────── */}
    <dialog
      id="gallery-lightbox"
      class="fixed inset-0 z-50 m-0 h-dvh w-dvw max-h-none max-w-none bg-dark/95 backdrop:bg-dark/80 open:flex open:items-center open:justify-center"
      aria-label="Image gallery lightbox"
    >
      <div class="relative flex h-full w-full items-center justify-center">
        {/* Close button */}
        <button
          type="button"
          data-lightbox-close
          class="absolute right-3 top-3 z-10 flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-5 sm:top-5"
          aria-label="Close lightbox"
        >
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

        {/* Previous button */}
        <button
          type="button"
          data-lightbox-prev
          class="absolute left-2 z-10 flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:left-5"
          aria-label="Previous image"
        >
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        {/* Image container */}
        <figure class="flex max-h-[85dvh] max-w-[90vw] flex-col items-center gap-3 sm:max-w-[80vw]" data-lightbox-figure>
          <img
            src=""
            alt=""
            class="max-h-[75dvh] max-w-full rounded-md object-contain"
            data-lightbox-img
          />
          <figcaption class="text-center text-sm text-white/80" data-lightbox-caption></figcaption>
        </figure>

        {/* Next button */}
        <button
          type="button"
          data-lightbox-next
          class="absolute right-2 z-10 flex size-11 items-center justify-center rounded-full bg-white/10 text-white transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:right-5"
          aria-label="Next image"
        >
          <svg class="size-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        {/* Counter */}
        <span
          class="absolute bottom-4 left-1/2 -translate-x-1/2 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white/80"
          data-lightbox-counter
          aria-live="polite"
        ></span>
      </div>
    </dialog>

    {
      ctaLabel && (
        <div class="mt-10 text-center">
          <a
            href={ctaHref}
            class="inline-flex min-h-11 items-center gap-2 rounded-md border-2 border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg"
          >
            {ctaLabel}
            <svg
              class="size-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>
      )
    }
  </div>
</section>

<script>
  function initGallery() {
    // ── Thumbnail loading states ──────────────────────────────────
    document.querySelectorAll<HTMLElement>("[data-gallery-item]").forEach((item) => {
      const img = item.querySelector<HTMLImageElement>("[data-gallery-img]");
      const skeleton = item.querySelector<HTMLElement>("[data-skeleton]");
      const errorState = item.querySelector<HTMLElement>("[data-error-state]");
      if (!img || !skeleton || !errorState) return;

      function onLoad() {
        img!.classList.remove("opacity-0");
        skeleton!.remove();
      }

      function onError() {
        skeleton!.remove();
        img!.classList.add("hidden");
        errorState!.classList.remove("hidden");
        errorState!.classList.add("flex");
      }

      if (img.complete) {
        img.naturalWidth > 0 ? onLoad() : onError();
        return;
      }

      img.addEventListener("load", onLoad, { once: true });
      img.addEventListener("error", onError, { once: true });
    });

    // ── Lightbox ──────────────────────────────────────────────────
    const dialog = document.getElementById("gallery-lightbox") as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.lbInit === "true") return;
    dialog.dataset.lbInit = "true";

    const lbImg = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const lbCaption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const lbCounter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]")!;
    const btnClose = dialog.querySelector<HTMLButtonElement>("[data-lightbox-close]")!;
    const btnPrev = dialog.querySelector<HTMLButtonElement>("[data-lightbox-prev]")!;
    const btnNext = dialog.querySelector<HTMLButtonElement>("[data-lightbox-next]")!;

    // Collect image data from rendered thumbnails
    type Slide = { src: string; alt: string };
    let slides: Slide[] = [];
    let current = 0;
    let triggerEl: HTMLElement | null = null;

    function collectSlides() {
      slides = [];
      document.querySelectorAll<HTMLElement>("[data-gallery-item]").forEach((item) => {
        const img = item.querySelector<HTMLImageElement>("[data-gallery-img]");
        if (!img) return;
        slides.push({ src: img.currentSrc || img.src, alt: img.alt });
      });
    }

    function show(index: number) {
      current = ((index % slides.length) + slides.length) % slides.length;
      const slide = slides[current];
      lbImg.src = slide.src;
      lbImg.alt = slide.alt;
      lbCaption.textContent = slide.alt;
      lbCounter.textContent = `${current + 1} / ${slides.length}`;
    }

    function open(index: number, trigger: HTMLElement) {
      collectSlides();
      if (slides.length === 0) return;
      triggerEl = trigger;
      show(index);
      dialog?.showModal();
    }

    function close() {
      dialog?.close();
      triggerEl?.focus();
      triggerEl = null;
    }

    // Open on thumbnail click
    document.addEventListener("click", (e) => {
      const btn = (e.target as Element).closest<HTMLElement>("[data-gallery-index]");
      if (!btn) return;
      const idx = parseInt(btn.dataset.galleryIndex ?? "0", 10);
      open(idx, btn);
    });

    // Navigation buttons
    btnClose.addEventListener("click", close);
    btnPrev.addEventListener("click", () => show(current - 1));
    btnNext.addEventListener("click", () => show(current + 1));

    // Close on backdrop click (native dialog fires click on the dialog itself)
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) close();
    });

    // Keyboard navigation (arrows handled inside the open dialog)
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowLeft") { e.preventDefault(); show(current - 1); }
      if (e.key === "ArrowRight") { e.preventDefault(); show(current + 1); }
    });

    // ── Touch / swipe support ─────────────────────────────────────
    let touchStartX = 0;
    let touchStartY = 0;
    let swiping = false;

    dialog.addEventListener("touchstart", (e) => {
      if (e.touches.length !== 1) return;
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
      swiping = true;
    }, { passive: true });

    dialog.addEventListener("touchend", (e) => {
      if (!swiping || e.changedTouches.length !== 1) return;
      swiping = false;
      const dx = e.changedTouches[0].clientX - touchStartX;
      const dy = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(dx) < 50 || Math.abs(dy) > Math.abs(dx)) return;
      dx < 0 ? show(current + 1) : show(current - 1);
    }, { passive: true });

    // Clean up dialog-init flag on page swap so it re-binds
    document.addEventListener("astro:before-swap", () => {
      dialog.dataset.lbInit = "";
    });
  }

  initGallery();
  document.addEventListener("astro:after-swap", initGallery);
</script>
